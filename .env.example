# Copy this file to `.env` and fill in your values for local development.
# Get a free access key at https://web3forms.com (enter your email, no signup).
VITE_WEB3FORMS_KEY=your-access-key-here

# Contact details shown on the site.
VITE_CONTACT_EMAIL=your-email@example.com
# WhatsApp phone in international format, digits only (no + or spaces).
VITE_CONTACT_PHONE=
